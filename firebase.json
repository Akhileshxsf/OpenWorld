{
  "functions": [
    {
      "source": "functions",
      "codebase": "whatsapp",
      "ignore": [
        "node_modules",
        ".git",
        ".env.*",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/whatsapp",
        "function": "whatsappWebhook"
      },
      {
        "source": "/api/whatsapp/meta",
        "function": "metaWhatsappWebhook"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
